# Database
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=fastpay
DATABASE_URL="postgresql://postgres:password@localhost:5432/fastpay?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Backend API
PORT=3000
JWT_SECRET=super_secret_jwt_key
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super_secret_refresh_key
JWT_REFRESH_EXPIRES_IN=7d

# Encryption (AES-256-GCM) - MUST BE 32 BYTES HEX OR BASE64!
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# S3 (Object Storage)
S3_ENDPOINT=https://your-endpoint.s3.eu-central-1.amazonaws.com
S3_REGION=eu-central-1
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_BUCKET_NAME=fastpay-bucket
