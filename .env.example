# Database
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=fastpay
DATABASE_URL="postgresql://postgres:password@localhost:5432/fastpay?schema=public"

# Redis (optional for MVP)
REDIS_HOST=localhost
REDIS_PORT=6379

# Backend API
PORT=3000
JWT_SECRET=super_secret_jwt_key
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super_secret_refresh_key
JWT_REFRESH_EXPIRES_IN=7d

# Encryption (AES-256-GCM) — 64 hex chars = 32 bytes
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Telegram — use the SAME token for both (bot + Mini App auth)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
BOT_TOKEN=your_telegram_bot_token

# Frontend URL for WebApp button
FRONTEND_URL=http://localhost:5173

# S3 (optional — not required for MVP)
S3_ENDPOINT=https://your-endpoint.s3.eu-central-1.amazonaws.com
S3_REGION=eu-central-1
S3_ACCESS_KEY=your_access_key
S3_SECRET_KEY=your_secret_key
S3_BUCKET_NAME=fastpay-bucket
