
generator client {
  provider = "prisma-client-js"
  engineType = "library"
  output = "../backend/node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  telegramId    BigInt    @unique
  username      String?
  firstName     String?
  avatarUrl     String?
  balance       Int       @default(0) // UZS, faqat backend o'zgartiradi
  createdAt     DateTime  @default(now())
  orders        Order[]
  topups        Topup[]
}

model Product {
  id            String    @id @default(cuid())
  category      String    // "UC" | "STARS" | "SUBSCRIPTION" | "PREMIUM"
  label         String    // "60 UC", "75 Stars"
  amount        Int       // 60, 75 — real miqdor
  priceUzs      Int
  isFeatured    Boolean   @default(false)
  isActive      Boolean   @default(true)
  sortOrder     Int       @default(0)

  orders        Order[]
}

model Order {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  productId     String
  product       Product   @relation(fields: [productId], references: [id])
  targetId      String    // PUBG ID yoki @username
  status        OrderStatus @default(PENDING)
  priceUzs      Int       // xarid vaqtidagi narx (snapshot, Product narxi keyin o'zgarsa ham)
  createdAt     DateTime  @default(now())
  fulfilledAt   DateTime?
  fulfilledBy   String?   // admin telegram id
  cancelReason  String?
}

enum OrderStatus {
  PENDING
  CONFIRMED
  FULFILLED
  CANCELLED
}

model Topup {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  amountUzs     Int
  method        String    // "UZCARD_HUMO" | "BANKOMAT"
  status        TopupStatus @default(PENDING)
  createdAt     DateTime  @default(now())
  approvedAt    DateTime?
  approvedBy    String?   // admin telegram id
  rejectReason  String?
}

enum TopupStatus {
  PENDING
  APPROVED
  REJECTED
}

model AdminAction {
  id            String    @id @default(cuid())
  adminId       String
  action        String    // "APPROVE_TOPUP" | "REJECT_TOPUP" | "FULFILL_ORDER"
  targetId      String
  createdAt     DateTime  @default(now())
}
